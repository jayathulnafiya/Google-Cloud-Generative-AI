# Copy this file to .env and fill in your own key.
#   Windows :  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# Get a free Gemini API key at https://aistudio.google.com/apikey
# The key starts with "AQ." (Auth key) or "AIza" (Standard key).
# IMPORTANT: an "sk-..." key is an OpenAI key and will be rejected by Gemini.

GEMINI_API_KEY=your_gemini_key_here

# Optional: change the Gemini model without editing any code.
# gemini-3.6-flash is the default because the newest models often return
# 429 RESOURCE_EXHAUSTED on free-tier keys.
# GEMINI_MODEL=gemini-3.6-flash

# --- Optional: run on an OpenAI-compatible endpoint instead of Gemini ---
# The app defaults to Gemini. Uncomment these lines to switch provider
# (works with OpenAI itself, or any OpenAI-compatible gateway).
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1